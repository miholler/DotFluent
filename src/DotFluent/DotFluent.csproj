<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Version>4.1.0</Version>
    <Description>A .NET library that provides fluent extension members for commonly used types, making everyday guard checks, string tests, dictionary operations, LINQ queries, and async task composition more expressive and readable.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Fluent, Extensions, Guard, Nullable, String, Collection, Dictionary, Linq, Task, ValueTask, Promise, Chainable</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" PackagePath="\" Pack="true" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.Memory" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>
</Project>
