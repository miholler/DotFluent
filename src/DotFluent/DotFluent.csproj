<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Michael Holler</Authors>
    <Copyright>Copyright © 2019 Michael Holler</Copyright>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <Version>4.1.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Provides a set of extension members for commonly used types within .Net (C#) to enable writing code fluently. Also adds support for different patterns like the option or result pattern (unions) and further enhances .Net features like LINQ by adding more methods and overloads to existing methods as well as bringing promise like extensions to .Net Tasks.</Description>
    <PackageProjectUrl>https://bitbucket.org/miholler/dotfluent/wiki/Home</PackageProjectUrl>
    <PackageTags>Fluent, Extensions, Linq, Task, Promise, Result, Either, Option, Maybe, Union, Nullable</PackageTags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PolySharpUsePublicAccessibilityForGeneratedTypes>true</PolySharpUsePublicAccessibilityForGeneratedTypes>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" PackagePath="\" Pack="true" Visible="false" />
  </ItemGroup>
</Project>
