<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>5.0.0</Version>
    <Description>A .NET library that provides fluent extension members for commonly used types, making everyday guard checks, string tests, collection operations, LINQ queries, and async task composition more expressive and readable.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Fluent, Extensions, Guard, Nullable, String, Collection, Dictionary, Linq, Task, ValueTask, Promise</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" PackagePath="\" Pack="true" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.Memory" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
