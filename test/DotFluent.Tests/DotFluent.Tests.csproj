<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DotFluent</RootNamespace>
    <TargetFrameworks>netframework48;net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netframework48'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DotFluent\DotFluent.csproj" />
    <ProjectReference Include="..\DotFluent.TestCommon\DotFluent.TestCommon.csproj" />
  </ItemGroup>
</Project>
